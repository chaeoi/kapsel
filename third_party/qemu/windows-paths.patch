+static HANDLE open_file_utf8(const char *filename, DWORD access, DWORD share,
+                             DWORD disposition, DWORD flags)
+{
+    gunichar2 *path = g_utf8_to_utf16(filename, -1, NULL, NULL, NULL);
+    if (!path) {
+        SetLastError(ERROR_NO_UNICODE_TRANSLATION);
+        return INVALID_HANDLE_VALUE;
+    }
+    HANDLE file = CreateFileW((LPCWSTR)path, access, share, NULL, disposition,
+                              flags, NULL);
+    DWORD error = GetLastError();
+    g_free(path);
+    SetLastError(error);
+    return file;
+}
