#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "version.h"

1 RT_MANIFEST "kapsel.exe.manifest"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 VERSIONINFO
FILEVERSION KAPSEL_FILE_VERSION
PRODUCTVERSION KAPSEL_FILE_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Kapsel"
            VALUE "FileVersion", KAPSEL_VERSION
            VALUE "OriginalFilename", "Kapsel.exe"
            VALUE "ProductName", "Kapsel"
            VALUE "ProductVersion", KAPSEL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_KAPSEL DIALOGEX 0, 0, 420, 249
STYLE DS_SETFONT | DS_CENTER | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Kapsel"
FONT 10, "Microsoft YaHei UI"
BEGIN
    CONTROL "Kapsel", IDC_BRAND, "Static", SS_LEFTNOWORDWRAP, 19, 51, 92, 27
    LTEXT "虚拟硬盘", IDC_DISK_LABEL, 19, 111, 81, 12
    CONTROL "", IDC_DISK_VALUE, "Static", SS_LEFTNOWORDWRAP, 19, 128, 92, 27
    LTEXT "", IDC_DISK_NOTE, 19, 161, 81, 13
    LTEXT "vm.qcow2", IDC_DISK_FILE, 19, 219, 81, 13

    LTEXT "启动来源", IDC_BOOT_HEADING, 136, 19, 266, 19
    CONTROL "", IDC_ISO, "Edit", ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP, 143, 43, 166, 13
    CONTROL "选择 ISO…(&O)", IDC_BROWSE, "Button", BS_OWNERDRAW | WS_TABSTOP, 323, 36, 79, 26

    LTEXT "虚拟硬件", IDC_HARDWARE_HEADING, 136, 82, 266, 19
    LTEXT "虚拟 CPU", -1, 136, 108, 82, 13
    CONTROL "", IDC_CPU, "Edit", ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP, 143, 131, 69, 14
    LTEXT "内存", -1, 227, 108, 82, 13
    CONTROL "", IDC_MEMORY, "Edit", ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP, 234, 131, 48, 14
    RTEXT "GiB", IDC_MEMORY_UNIT, 281, 131, 22, 13
    LTEXT "新盘容量", IDC_DISK_SIZE_LABEL, 318, 108, 84, 13
    CONTROL "", IDC_DISK_SIZE, "Edit", ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP, 325, 131, 47, 14
    RTEXT "GiB", IDC_DISK_UNIT, 372, 131, 23, 13

    AUTOCHECKBOX "优先使用 WHPX 硬件加速", IDC_WHPX, 136, 164, 266, 15, WS_TABSTOP
    LTEXT "", IDC_STATUS, 136, 192, 266, 13
    CONTROL "从硬盘启动(&D)", IDC_BOOT_DISK, "Button", BS_OWNERDRAW | WS_TABSTOP, 217, 214, 87, 26
    CONTROL "从 ISO 启动(&I)", IDC_BOOT_ISO, "Button", BS_OWNERDRAW | WS_TABSTOP, 313, 214, 89, 26
END
